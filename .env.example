# Front / Nginx
BACKEND_URL=http://host.docker.internal:8080
GRAFANA_DASHBOARD_URL=/grafana/d/familia-connect/familia-connect-visao-geral?orgId=1
# Vite local (npm run dev)
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/familia-connect/familia-connect-visao-geral?orgId=1
# Grafana interno (em desenvolvimento, publique a porta 3000 apenas localmente)
GRAFANA_DEV_URL=http://localhost:80
GRAFANA_ROOT_URL=http://localhost/grafana/
GRAFANA_ADMIN_PASSWORD=defina-uma-senha-forte
# Mesmo segredo configurado no backend como GRAFANA_API_TOKEN
GRAFANA_API_TOKEN=defina-um-segredo-longo-aleatorio
GRAFANA_BACKEND_URL=http://host.docker.internal:8080
