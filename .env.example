# Copie para .env (o docker-compose lê este arquivo automaticamente).

# --- Front ---
# API_BASE_URL=/api
# BACKEND_URL=http://host.docker.internal:8080

# --- Grafana (dashboard) ---
# Troque a senha do administrador do Grafana (usada só em /grafana/login, que também exige estar logado no sistema).
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# URL pública do front + /grafana/ (usada pelo Grafana para montar links)
GRAFANA_ROOT_URL=http://localhost/grafana/

# Banco do Família Connect (o mesmo do DB_URL do back) e o usuário somente-leitura de grafana/sql/usuario-somente-leitura.sql
GRAFANA_DB_HOST=host.docker.internal
GRAFANA_DB_PORT=3306
GRAFANA_DB_NAME=familia_connect
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=troque-esta-senha
